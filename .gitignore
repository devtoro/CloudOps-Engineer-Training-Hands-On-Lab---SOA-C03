# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------

# Provider/module cache and plugins (huge binaries, regenerated by `terraform init`)
**/.terraform/
**/.terraform.tfstate.lock.info

# State files — may contain secrets; belong in a remote backend, never in git
*.tfstate
*.tfstate.*
*.tfstate.backup

# Saved plan output
*.tfplan
tfplan
**/tfplan

# Crash logs
crash.log
crash.*.log

# Variable files that commonly hold secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / credentials
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it should be committed.

# ---------------------------------------------------------------------------
# Secrets / credentials
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials
aws-credentials*

# ---------------------------------------------------------------------------
# Python (Lambda sources, scripts)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Lambda build/packaging artifacts
*.zip
build/
dist/
package/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
